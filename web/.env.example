# Copy this file to `.env.local` and fill in your values.
# `npm run dev` loads `.env.local` automatically (see Next.js env docs).

# --- Supabase (Dashboard → Project Settings → API) ---
# Public: safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the client or commit to git
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=

# --- Vercel (optional — mostly for `vercel` CLI or local linking) ---
# Production/staging secrets are usually set in the Vercel project dashboard.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- App ---
# Used for OAuth redirects, emails, absolute URLs in dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
