# OS
.DS_Store
Thumbs.db

# Editor / tooling
.idea/
.vscode/
*.swp
*.swo

# Optional Python backend or scripts (add later)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Secrets & env (never commit)
# Root `.env` alone does not match `web/.env` — use broad patterns for nested apps.
*.pem
*.p12
.env*
!.env.example
!**/.env.example
.envrc
.direnv/

# Accidental credential / key dumps (common filenames)
*credentials*.json
*service-account*.json
*service_account*.json
secrets*.json
*-firebase-adminsdk*.json
